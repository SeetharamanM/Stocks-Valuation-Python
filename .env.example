# Copy to .env to override the defaults. All of these are optional -- the app
# runs with none of them set. There are no API keys here: the analysis is
# computed entirely in Python and nothing is sent anywhere.

RISK_FREE_RATE=0.069          # 10-yr India G-Sec, also overridable in the form
EQUITY_RISK_PREMIUM=0.055     # also overridable in the form
STATUTORY_TAX=0.2517          # the rate the forecast fades the effective rate toward
COST_OF_DEBT_PRE_TAX=0.09     # assumed; not derivable from the Screener export
